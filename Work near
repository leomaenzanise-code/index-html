<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>WorkNear Global + Rating</title>
<style>
body{font-family:Arial;margin:0;background:#f6f7fb}
.header{background:#111;color:#fff;padding:12px;text-align:center;position:sticky;top:0;z-index:10}
.support-bar{background:#d4af37;color:#000;padding:8px;text-align:center;font-weight:bold;font-size:13px}
.location-bar{background:#fff;padding:8px;display:flex;gap:6px;flex-wrap:wrap}
.location-bar select,.location-bar input{padding:10px;border-radius:8px;border:1px solid #ddd;flex:1}
.filters{display:flex;gap:6px;padding:8px;overflow-x:auto;background:#fff}
.f-btn{padding:8px 12px;border-radius:20px;border:1px solid #ddd;background:#fff;cursor:pointer;font-size:12px;white-space:nowrap}
.f-btn.active{background:#111;color:#fff}
.tabs{display:flex;background:#fff}
.tab{flex:1;padding:12px;text-align:center;font-weight:bold;cursor:pointer;border-bottom:3px solid transparent;font-size:13px}
.tab.active{border-color:#d4af37}
.job-card{background:#fff;margin:10px;border-radius:14px;padding:14px;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.badge{font-size:10px;padding:3px 8px;border-radius:20px;background:#eee}
.wa{background:#25D366;color:#fff}.gold{background:#d4af37;color:#000}.green{background:#00a651;color:#fff}
button{border:none;padding:11px;border-radius:10px;width:100%;font-weight:bold;cursor:pointer;margin-top:6px}
input,select{width:100%;padding:10px;margin:4px 0;border-radius:8px;border:1px solid #ddd;box-sizing:border-box}
.rate-btn{background:#fff;border:1px solid #ddd;padding:6px;font-size:11px;flex:1}
.report-btn{background:#fff;border:1px solid #ff4444;color:#ff4444;padding:6px;font-size:11px;flex:1}
</style>
</head>
<body>
<div class="header"><b>WorkNear Global</b> • Rating System<br><span id="locStatus" style="font-size:11px">Loading...</span></div>
<div class="support-bar">Support / Pay 10 ZiG Help: <a href="https://wa.me/263779757160" style="color:#000">0779757160</a></div>
<div class="location-bar">
<select id="countrySelect"></select>
<input id="cityInput" placeholder="City e.g. Marondera"><button onclick="saveLocation()" style="width:auto">Save</button><button onclick="detectGPS()" style="width:auto">📍</button>
</div>
<div class="filters">
<button class="f-btn active" onclick="setDist(2,this)">2km</button><button class="f-btn" onclick="setDist(5,this)">5km</button><button class="f-btn" onclick="setDist(20,this)">20km</button><button class="f-btn" onclick="setDist(100,this)">100km</button><span id="countLabel" style="margin-left:auto;font-size:11px"></span>
</div>
<div class="tabs"><div class="tab active" id="tFind" onclick="switchTab('find')">Find Work</div><div class="tab" id="tPost" onclick="switchTab('post')">Post + Refer</div><div class="tab" id="tCarrier" onclick="switchTab('carrier')">Lorry 🚚</div></div>
<div id="findTab"><div id="jobsList"></div></div>
<div id="postTab" style="display:none;padding:10px">
<div class="job-card"><h3>Post Job</h3><input id="pTitle" placeholder="Title e.g. Need Bricklayer"><input id="pPay" placeholder="Pay e.g. 20 ZiG"><input id="pCity" placeholder="City"><input id="pArea" placeholder="Area"><input id="pPhone" placeholder="WhatsApp 263..."><button onclick="postJob()">Post</button></div>
<div class="job-card"><h3>🎁 Refer 10 = 20 ZiG</h3>Code: <b id="myCode"></b><input id="refLink" readonly><button class="wa" onclick="shareReferral()">Share Referral Link</button><p style="font-size:11px">Users: <span id="totalUsersLabel"></span> / FREE left: <span id="freeLeft"></span></p></div>
</div>
<div id="carrierTab" style="display:none;padding:10px">
<div class="job-card" style="border:2px solid #00a651"><h3>🚚 Register Carrier</h3><select id="carrierType"><option>Pickup / Lorry 1-3t</option><option>Truck 5-10t</option><option>Van</option><option>Trolley</option></select><input id="vName" placeholder="Full Name"><input id="vID" placeholder="ID Number"><input id="vLicense" placeholder="License"><input id="vLorryReg" placeholder="Reg e.g. AFE 1234"><input id="vPhone" placeholder="WhatsApp"><label><input type="checkbox" id="checkID"> ID Photo ready</label><br><label><input type="checkbox" id="checkLicense"> License ready</label><br><label><input type="checkbox" id="checkLorry"> Lorry Book ready</label><button class="green" onclick="registerCarrier()">Submit Verification</button><p id="verifyStatus" style="font-size:11px"></p></div><div id="carrierList"></div>
</div>
<script>
const countries=[{name:"Zimbabwe",symbol:"ZiG $"},{name:"Zambia",symbol:"K"},{name:"South Africa",symbol:"R"},{name:"Mozambique",symbol:"MT"},{name:"India",symbol:"₹"},{name:"Kenya",symbol:"KSh"},{name:"Nigeria",symbol:"₦"},{name:"United Kingdom",symbol:"£"},{name:"United States",symbol:"$"}];
let userLoc=JSON.parse(localStorage.getItem('worknear_loc')||'{"country":"Zimbabwe","city":"Harare","lat":-17.8292,"lon":31.0522}');
let maxDist=2,currencySymbol="ZiG $";
let jobs=JSON.parse(localStorage.getItem('worknear_jobs_global')||'null')||[{id:1,title:"Shop Assistant",pay:"15",time:"Morning",city:"Harare",country:"Zimbabwe",area:"CBD",lat:-17.8292,lon:31.0522,phone:"263771234567",type:"Job"},{id:2,title:"Barber Shamva",pay:"$3/cut",time:"Evening",city:"Shamva",country:"Zimbabwe",area:"Main",lat:-17.316,lon:31.55,phone:"263773456789",type:"Service"}];
let carriers=JSON.parse(localStorage.getItem('worknear_carriers')||'[]');
let unlockedJobs=JSON.parse(localStorage.getItem('unlocked_jobs')||'{}');
let ratings=JSON.parse(localStorage.getItem('worknear_ratings')||'{}');
let totalUsers=parseInt(localStorage.getItem('worknear_total_users')||'87');
let currentUser=JSON.parse(localStorage.getItem('worknear_me')||'null');
function init(){let sel=document.getElementById('countrySelect');countries.forEach(c=>{let o=document.createElement('option');o.value=c.name;o.text=c.name;if(c.name===userLoc.country)o.selected=true;sel.appendChild(o);});let urlParams=new URLSearchParams(window.location.search);let ref=urlParams.get('ref');if(ref){let cnt=parseInt(localStorage.getItem('ref_'+ref)||'0')+1;localStorage.setItem('ref_'+ref,cnt);if(cnt===10)alert(`Referrer ${ref} got 10! Send 20 ZiG`);}let phone=localStorage.getItem('worknear_phone')||'';if(!phone){phone=prompt("Enter WhatsApp number\nFirst 100 FREE 30 days!");if(phone){localStorage.setItem('worknear_phone',phone);registerUser(phone);}}else if(!currentUser)registerUser(phone);updateReferralUI();changeCountry();render();renderCarriers();}
function registerUser(phone){if(!currentUser){totalUsers++;localStorage.setItem('worknear_total_users',totalUsers);currentUser={id:totalUsers,phone:phone,joined:Date.now(),freeUntil:Date.now()+30*86400000,referralCode:"WN"+phone.slice(-4)+totalUsers,isFree:totalUsers<=100};localStorage.setItem('worknear_me',JSON.stringify(currentUser));alert(totalUsers<=100?`🎉 You #${totalUsers} FREE 30 days! Code ${currentUser.referralCode}`:`You #${totalUsers} Pay 10 ZiG. Refer 10 = 20 ZiG Code ${currentUser.referralCode}`);}checkFreeStatus();}
function checkFreeStatus(){if(!currentUser)return true;let free=currentUser.isFree&&Date.now()<currentUser.freeUntil;if(!free&&currentUser.isFree&&Date.now()>=currentUser.freeUntil){alert(`Free month over! Now 10 ZiG or refer 10 for 20 ZiG. Help 0779757160`);currentUser.isFree=false;localStorage.setItem('worknear_me',JSON.stringify(currentUser));}return free||(currentUser.isFree&&Date.now()<currentUser.freeUntil);}
function updateReferralUI(){if(!currentUser)return;document.getElementById('myCode').innerText=currentUser.referralCode;document.getElementById('refLink').value=`https://worknear.co.zw?ref=${currentUser.referralCode}`;document.getElementById('totalUsersLabel').innerText=totalUsers;document.getElementById('freeLeft').innerText=Math.max(0,100-totalUsers);}
function changeCountry(){let c=countries.find(x=>x.name===document.getElementById('countrySelect').value);currencySymbol=c?c.symbol:"$";document.getElementById('locStatus').innerText=`${userLoc.city}, ${userLoc.country} • ${currencySymbol} • ${maxDist}km • Users ${totalUsers}/100`;render();}
function saveLocation(){userLoc.country=document.getElementById('countrySelect').value;userLoc.city=document.getElementById('cityInput').value||"Harare";localStorage.setItem('worknear_loc',JSON.stringify(userLoc));changeCountry();}
function detectGPS(){if(!navigator.geolocation)return;document.getElementById('locStatus').innerText="GPS...";navigator.geolocation.getCurrentPosition(p=>{userLoc.lat=p.coords.latitude;userLoc.lon=p.coords.longitude;localStorage.setItem('worknear_loc',JSON.stringify(userLoc));render();});}
function setDist(km,el){maxDist=km;document.querySelectorAll('.f-btn').forEach(b=>b.classList.remove('active'));if(el)el.classList.add('active');render();}
function haversine(lat1,lon1,lat2,lon2){const R=6371;const dLat=(lat2-lat1)*Math.PI/180;const dLon=(lon2-lon1)*Math.PI/180;const a=Math.sin(dLat/2)**2+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));}
function switchTab(t){document.getElementById('findTab').style.display=t==='find'?'block':'none';document.getElementById('postTab').style.display=t==='post'?'block':'none';document.getElementById('carrierTab').style.display=t==='carrier'?'block':'none';document.getElementById('tFind').classList.toggle('active',t==='find');document.getElementById('tPost').classList.toggle('active',t==='post');document.getElementById('tCarrier').classList.toggle('active',t==='carrier');}
function postJob(){let j={id:Date.now(),title:document.getElementById('pTitle').value,pay:document.getElementById('pPay').value||"15",time:"Flexible",city:document.getElementById('pCity').value||userLoc.city,country:document.getElementById('countrySelect').value,area:document.getElementById('pArea').value||userLoc.city,phone:document.getElementById('pPhone').value,type:"Job",lat:userLoc.lat+(Math.random()-0.5)*0.2,lon:userLoc.lon+(Math.random()-0.5)*0.2};if(!j.title||!j.phone){alert("Title & Phone");return;}jobs.push(j);localStorage.setItem('worknear_jobs_global',JSON.stringify(jobs));alert(`Posted in ${j.city}`);render();}
function shareReferral(){let link=document.getElementById('refLink').value;let msg=`Join WorkNear! Jobs 2km near ${userLoc.city}. First 100 FREE! Code ${currentUser.referralCode} ${link}`;window.open(`https://wa.me/?text=${encodeURIComponent(msg)}`,"_blank");}
function payToUnlock(empPhone,title,jobId){let free=checkFreeStatus();if(free){unlockedJobs[jobId]=true;openWhatsAppDirect(empPhone,title);render();return;}if(unlockedJobs[jobId]){openWhatsAppDirect(empPhone,title);return;}let wp=prompt(`UNLOCK ${title}\nPay 10 ZiG DIRECT chat\nHelp 0779757160\nEnter EcoCash ZiG number`);if(!wp)return;setTimeout(()=>{unlockedJobs[jobId]=true;localStorage.setItem('unlocked_jobs',JSON.stringify(unlockedJobs));alert(`✅ 10 ZiG Paid! Direct chat`);openWhatsAppDirect(empPhone,title);render();},1000);}
function openWhatsAppDirect(p,t){window.open(`https://wa.me/${p}?text=${encodeURIComponent(`Hi, WorkNear ${t} in ${userLoc.city}. Available now.`)}`,"_blank");}
// RATING FUNCTIONS
function rateUser(jobId,phone,name){let r=prompt(`Rate ${name}\n5=Excellent honest\n4=Good\n3=Okay\n2=Bad\n1=Dishonest\n\nHelp 0779757160 to report`);if(!r)return;r=parseInt(r);if(r<1||r>5)return;if(!ratings[jobId])ratings[jobId]=[];ratings[jobId].push(r);localStorage.setItem('worknear_ratings',JSON.stringify(ratings));let carrier=carriers.find(c=>c.id==jobId||c.phone==phone);if(carrier){let avg=ratings[jobId].reduce((a,b)=>a+b,0)/ratings[jobId].length;carrier.rating=parseFloat(avg.toFixed(1));carrier.jobsDone=ratings[jobId].length;localStorage.setItem('worknear_carriers',JSON.stringify(carriers));}alert(`Rated ${r} stars`);render();renderCarriers();}
function getStars(jobId){let arr=ratings[jobId]||[];if(arr.length==0)return{avg:5,count:0,text:"⭐⭐⭐⭐⭐ New"};let avg=arr.reduce((a,b)=>a+b,0)/arr.length;let full=Math.round(avg);let stars="⭐".repeat(full)+"☆".repeat(5-full);return{avg:avg,count:arr.length,text:`${stars} ${avg.toFixed(1)} (${arr.length})`};}
function reportUser(phone,name){if(!confirm(`Report ${name} for fraud? Sent to 0779757160`))return;let reason=prompt("What happened?");if(!reason)return;window.open(`https://wa.me/263779757160?text=${encodeURIComponent(`REPORT ${name} ${phone} Reason: ${reason} Reporter ${currentUser?.phone}`)}`,"_blank");}
function render(){let selCountry=document.getElementById('countrySelect').value;let selCity=document.getElementById('cityInput').value.toLowerCase();let list=document.getElementById('jobsList');let html="";let count=0;jobs.slice().reverse().forEach(job=>{if(job.country!==selCountry)return;if(selCity.length>2&&!job.city.toLowerCase().includes(selCity)&&!job.area.toLowerCase().includes(selCity))return;let dist=haversine(userLoc.lat,userLoc.lon,job.lat,job.lon);if(dist>maxDist)return;let rating=getStars(job.id);if(rating.avg<2 && rating.count>=3)return; // AUTO-HIDE dishonest count++;let unlocked=unlockedJobs[job.id];let free=checkFreeStatus();let btn=(unlocked||free)?`<button class="wa" onclick="openWhatsAppDirect('${job.phone}','${job.title}')">💬 WhatsApp DIRECT</button><p style="font-size:11px">📞 ${job.phone}</p><div style="display:flex;gap:4px"><button class="rate-btn" onclick="rateUser(${job.id},'${job.phone}','${job.title}')">⭐ Rate</button><button class="report-btn" onclick="reportUser('${job.phone}','${job.title}')">🚩 Report</button></div>`:`<button class="gold" onclick="payToUnlock('${job.phone}','${job.title}',${job.id})">🔓 Unlock 10 ZiG</button><small>${rating.text} • Help 0779757160</small>`;html+=`<div class="job-card" style="${rating.avg<2.5?'border:1px dashed #ff9800':''}"><div style="display:flex;justify-content:space-between;font-size:11px"><span class="badge">${job.type}</span><span>${dist.toFixed(1)}km</span></div><h3 style="margin:6px 0">${job.title} <span style="font-size:11px">${rating.text}</span></h3><div style="font-size:12px">💰 ${job.pay} • ${rating.text}</div><small>📍 ${job.area}, ${job.city}</small><div style="display:flex;gap:6px;margin-top:8px"><div style="flex:2">${btn}</div></div></div>`;});document.getElementById('countLabel').innerText=count+" jobs";list.innerHTML=html||`<div class="job-card">No jobs within ${maxDist}km</div>`;}
function registerCarrier(){let carrier={id:Date.now(),type:document.getElementById('carrierType').value,name:document.getElementById('vName').value,idNumber:document.getElementById('vID').value,license:document.getElementById('vLicense').value,lorryReg:document.getElementById('vLorryReg').value,phone:document.getElementById('vPhone').value,verified:false,rating:5,jobsDone:0,hasID:document.getElementById('checkID').checked,hasLicense:document.getElementById('checkLicense').checked,hasLorry:document.getElementById('checkLorry').checked};if(!carrier.name||!carrier.idNumber||!carrier.phone){alert("Name ID Phone");return;}carriers.push(carrier);localStorage.setItem('worknear_carriers',JSON.stringify(carriers));document.getElementById('verifyStatus').innerHTML=`✅ Sent! WhatsApp docs to 0779757160`;window.open(`https://wa.me/263779757160?text=${encodeURIComponent(`NEW CARRIER ${carrier.name} ID ${carrier.idNumber} Lorry ${carrier.lorryReg} Phone ${carrier.phone}`)}`,"_blank");renderCarriers();}
function renderCarriers(){let list=document.getElementById('carrierList');let html="";carriers.slice().reverse().forEach(car=>{let r=getStars(car.id);if(r.avg<2 && r.count>=3)return;html+=`<div class="job-card" style="${car.verified?'border-left:5px solid #00a651':''}"><div style="display:flex;justify-content:space-between"><b>${car.type} - ${car.lorryReg}</b>${car.verified?'<span style="background:#00a651;color:#fff;padding:3px 8px;border-radius:10px;font-size:11px">✓ VERIFIED</span>':'<span style="background:#ff9800;color:#fff;padding:3px 8px;border-radius:10px;font-size:11px">⏳ UNVERIFIED</span>'}</div><p style="font-size:12px">${car.name} • ${r.text}</p><small>ID ${car.idNumber.slice(0,4)}****</small><br><button class="${car.verified?'wa':'gold'}" onclick="payToUnlock('${car.phone}','Lorry ${car.lorryReg}',${car.id})">${car.verified?'💬 WhatsApp Verified':'🔓 Unlock 10 ZiG'}</button><div style="display:flex;gap:4px;margin-top:6px"><button class="rate-btn" onclick="rateUser(${car.id},'${car.phone}','${car.name}')">⭐ Rate</button><button class="report-btn" onclick="reportUser('${car.phone}','${car.name}')">🚩 Report Fraud to 0779757160</button></div></div>`;});list.innerHTML=html;}
init();
</script>
</body>
</html><!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>WorkNear Admin - Only You</title>
<style>
