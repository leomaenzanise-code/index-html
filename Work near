input,select{width:100%;padding:10px;margin:5px 0;border-radius:8px;border:none;box-sizing:border-box}
button{padding:12px;border-radius:10px;border:none;width:100%;font-weight:bold;cursor:pointer;margin-top:6px}
.gold{background:#d4af37;color:#000}.green{background:#00a651;color:#fff}.red{background:#ff4444;color:#fff}
</style>
</head>
<body>
<h2>🔐 WorkNear Admin Panel</h2>
<p style="font-size:11px;opacity:.6">Only you: 0779757160 | Password protected</p>

<div id="loginBox" class="card">
<h3>Login</h3>
<input id="adminPass" type="password" placeholder="Enter Admin Password">
<button class="gold" onclick="loginAdmin()">Login</button>
<small>Default password: 0779757160 — Change it after</small>
</div>

<div id="adminBox" style="display:none">

<div class="card">
<h3>⚙️ Commission & Free Weeks Control</h3>
<label>Current Commission (ZiG)</label>
<input id="setCommission" type="number" value="10">
<label>Free Weeks for New Users</label>
<select id="setFreeWeeks">
