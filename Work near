</select>
<label>First How Many Free?</label>
<input id="setFreeCount" type="number" value="100">
<button class="green" onclick="saveSettings()">💾 Save Settings - Update App for All Users</button>
<p id="saveStatus" style="font-size:11px;color:#00ff88"></p>
</div>

<div class="card">
<h3>📊 Your Business Stats</h3>
