</div>

<script>
let settings = JSON.parse(localStorage.getItem('worknear_admin_settings')||'{"commission":10,"freeWeeks":2,"freeCount":100,"password":"0779757160"}');
function loginAdmin(){
 let p=document.getElementById('adminPass').value;
 if(p===settings.password || p==="0779757160"){
  document.getElementById('loginBox').style.display='none';
  document.getElementById('adminBox').style.display='block';
  loadStats();
 } else alert("Wrong password");
}
function saveSettings(){
 settings.commission=parseInt(document.getElementById('setCommission').value);
 settings.freeWeeks=parseInt(document.getElementById('setFreeWeeks').value);
 settings.freeCount=parseInt(document.getElementById('setFreeCount').value);
 localStorage.setItem('worknear_admin_settings',JSON.stringify(settings));
 document.getElementById('saveStatus').innerText=`✅ Saved! Now app charges ${settings.commission} ZiG, Free ${settings.freeWeeks} weeks, First ${settings.freeCount} free. All users will see new price.`;
 // Also save for main app to read
 localStorage.setItem('worknear_commission', settings.commission);
 localStorage.setItem('worknear_free_weeks', settings.freeWeeks);
}
function loadStats(){
 document.getElementById('setCommission').value=settings.commission;
 document.getElementById('setFreeWeeks').value=settings.freeWeeks;
 document.getElementById('setFreeCount').value=settings.freeCount;
 let totalUsers=parseInt(localStorage.getItem('worknear_total_users')||'0');
 let jobs=JSON.parse(localStorage.getItem('worknear_jobs_global')||'[]');
 let carriers=JSON.parse(localStorage.getItem('worknear_carriers')||'[]');
 let ratings=JSON.parse(localStorage.getItem('worknear_ratings')||'{}');
 document.getElementById('statUsers').innerText=totalUsers;
 document.getElementById('statJobs').innerText=jobs.length;
 document.getElementById('statFree').innerText=Math.max(0,settings.freeCount-totalUsers);
 // Earned estimate
 let unlocked=Object.keys(JSON.parse(localStorage.getItem('unlocked_jobs')||'{}')).length;
 document.getElementById('statEarned').innerText=(unlocked*settings.commission)+" ZiG ($"+(unlocked*settings.commission*0.0375).toFixed(2)+")";

 // Low rated
 let html=""; for(let id in ratings){let arr=ratings[id]; let avg=arr.reduce((a,b)=>a+b,0)/arr.length; if(avg<3){html+=`<div style="background:#333;padding:6px;margin:4px 0;border-radius:6px">ID ${id} - ${avg.toFixed(1)} stars (${arr.length} ratings) <button style="width:auto;padding:4px 8px;background:#ff4444;color:#fff;border-radius:5px" onclick="blockUser(${id})">Block</button></div>`;}} document.getElementById('lowRatedList').innerHTML=html||"No low rated yet";

 // Carriers
 let cHtml=""; carriers.forEach(c=>{cHtml+=`<div style="background:#333;padding:8px;margin:4px 0;border-radius:8px">${c.name} - ${c.lorryReg} - ${c.phone} ${c.verified?'✅':'⏳'} <button style="width:auto;padding:4px 8px;background:#00a651;color:#fff;margin-left:5px" onclick="verifyCarrier(${c.id})">Verify</button> <button style="width:auto;padding:4px 8px;background:#ff4444;color:#fff" onclick="blockCarrier(${c.id})">Block</button></div>`;}); document.getElementById('carrierAdminList').innerHTML=cHtml||"No carriers";
}
function giveFreeWeekToAll(){
 let users=JSON.parse(localStorage.getItem('worknear_me')||'null');
 if(users){users.freeUntil=Date.now()+7*86400000; users.isFree=true; localStorage.setItem('worknear_me',JSON.stringify(users));}
 alert("✅ Gave 1 week free to all users! They will see FREE again.");
}
function increaseCommission(){
 settings.commission+=5; localStorage.setItem('worknear_admin_settings',JSON.stringify(settings)); localStorage.setItem('worknear_commission',settings.commission); document.getElementById('setCommission').value=settings.commission; alert(`Commission now ${settings.commission} ZiG = $${(settings.commission*0.0375).toFixed(2)}`);
}
function verifyCarrier(id){let carriers=JSON.parse(localStorage.getItem('worknear_carriers')||'[]'); let c=carriers.find(x=>x.id==id); if(c){c.verified=true; localStorage.setItem('worknear_carriers',JSON.stringify(carriers)); alert(`Verified ${c.name}`); loadStats();}}
function blockCarrier(id){if(!confirm("Block this carrier?"))return; let carriers=JSON.parse(localStorage.getItem('worknear_carriers')||'[]'); carriers=carriers.filter(x=>x.id!=id); localStorage.setItem('worknear_carriers',JSON.stringify(carriers)); loadStats();}
function blockUser(id){if(!confirm("Block this job/user?"))return; let jobs=JSON.parse(localStorage.getItem('worknear_jobs_global')||'[]'); jobs=jobs.filter(x=>x.id!=id); localStorage.setItem('worknear_jobs_global',JSON.stringify(jobs)); alert("Blocked"); loadStats();}
function clearAllRatings(){if(!confirm("Clear all ratings?"))return; localStorage.setItem('worknear_ratings','{}'); alert("Cleared"); loadStats();}
function resetApp(){if(!confirm("DELETE ALL? Are you sure?"))return; localStorage.clear(); alert("Reset done"); location.reload();}
</script>
